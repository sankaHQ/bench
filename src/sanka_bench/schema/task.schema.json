{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanka.com/schemas/sanka-bench/task/v0.3.json",
  "title": "Sanka Migration Bench task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "lane",
    "source",
    "target",
    "commands",
    "evaluation"
  ],
  "allOf": [
    {
      "if": { "properties": { "lane": { "const": "drf-fastapi" } } },
      "then": { "properties": { "target": { "properties": { "framework": { "const": "fastapi" } } } } }
    },
    {
      "if": { "properties": { "lane": { "const": "drf-flask" } } },
      "then": { "properties": { "target": { "properties": { "framework": { "const": "flask" } } } } }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "python-go"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "sanka-bench/task/v0.3"
          },
          "target": {
            "required": [
              "language",
              "database"
            ],
            "properties": {
              "framework": {
                "const": "fiber"
              },
              "orm": {
                "const": "none"
              },
              "entrypoint": {
                "const": "cmd/api/main.go"
              }
            }
          },
          "commands": {
            "required": [
              "target_regression"
            ]
          },
          "source": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              }
            }
          },
          "evaluation": {
            "properties": {
              "driver": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              "scenarios": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "schema_version": {
            "const": "sanka-bench/task/v0.2"
          },
          "target": {
            "properties": {
              "orm": {
                "const": "django"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "language"
                  ]
                },
                {
                  "required": [
                    "database"
                  ]
                }
              ]
            }
          },
          "commands": {
            "not": {
              "required": [
                "target_regression"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "enum": ["sanka-bench/task/v0.2", "sanka-bench/task/v0.3"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "lane": { "enum": ["drf-fastapi", "drf-flask", "python-go"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "framework", "python", "provenance"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "framework": { "const": "django-rest-framework" },
        "python": { "type": "string", "pattern": "^3\\.12(?:\\..+)?$" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "license", "digest"],
          "properties": {
            "kind": { "enum": ["synthetic", "repository"] },
            "repository": { "type": "string" },
            "commit": { "type": "string" },
            "license": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "orm",
        "entrypoint",
        "serving",
        "static_patterns"
      ],
      "properties": {
        "framework": { "enum": ["fastapi", "flask", "fiber"] },
        "orm": { "enum": ["django", "none"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forbidden_imports"],
          "properties": {
            "forbidden_imports": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "static_patterns": {
          "type": "object",
          "description": "Fast textual diagnostics over candidate-contributed files. Never a hard gate; the native-target gate uses recorded serving evidence.",
          "additionalProperties": false,
          "required": ["required", "forbidden"],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "forbidden": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "language": { "const": "go" },
        "database": { "const": "sqlite" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regression"],
      "properties": {
        "regression": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "target_regression": { "const": [["go", "build", "-mod=readonly", "./..."]] }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "scenarios", "repeat", "timeout_seconds"],
      "properties": {
        "driver": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "string", "minLength": 1 },
        "repeat": { "type": "integer", "minimum": 2, "maximum": 5 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    }
  }
}
